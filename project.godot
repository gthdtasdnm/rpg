QuestManager="*res://scripts/Quests/QuestManager.cs"
SaveSystem="*res://scripts/World/SaveSystem.cs"
DialogueManager="*uid://c3rodes2l3gxb"
SimpleGrass="*uid://bfq0snth8sj3h"

[dialogue_manager]

runtime/advanced/uses_dotnet=true

[display]


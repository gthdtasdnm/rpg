# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
*.blend

# Gekaufte/heruntergeladene Asset-Pakete (~800 MB).
# Bewusst NICHT im Repo: jederzeit neu herunterladbar, würden die Historie aber dauerhaft
# aufblähen (Git speichert große Binärdateien nicht dedupliziert - einmal drin, immer drin).
# Herkunft und Lizenz jedes Pakets stehen in Assets/README.md; auf einem neuen Rechner die
# Pakete erneut laden und danach einsortieren.
# Assets/Nature/ und Assets/Terrain/ sind bewusst NICHT ausgeschlossen - die sind bearbeitet
# (zusammengeführte Baum-Meshes, gepackte Terrain-Texturen) und nicht reproduzierbar.
Assets/Buildings/
Assets/Props/
Assets/Weapons/
Assets/Characters/
Assets/_Blender/

# Die unbearbeiteten Photogrammetrie-Steine (431 MB, bis zu 118 MB pro Datei). Die im Spiel
# benutzten Fassungen unter Assets/Nature/Rocks/ sind dezimiert und liegen im Repo - hier
# liegen nur die Rohdaten als Rückfallebene, falls neu aufbereitet werden muss.
Assets/Nature/Rocks/_original/
